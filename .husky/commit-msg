#!/usr/bin/env sh

msg_file="$1"
[ -f "$msg_file" ] || exit 0

first=$(head -n 1 "$msg_file")

case "$first" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

# type(scope): subject   — scope optional, subject must not be empty
if ! printf '%s\n' "$first" | grep -Eq \
  '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([[:alnum:]_.-]+\))?!?: .+'; then
  cat >&2 <<'EOF'
cdin: invalid commit message

  expected:  <type>(<scope>): <subject>
  types:     feat fix docs style refactor perf test build ci chore revert
  example:   feat(flow): allow custom release prefixes

  scope is optional; merge/revert commits are skipped automatically.
EOF
  exit 1
fi

exit 0
