gix:
  version: "1"
remote: origin
branch:
  main:
    name: main
    type: base
    delete_on_finish: false
  develop:
    name: develop
    type: base
    parent: main
    autosync: false
    delete_on_finish: false
  feature:
    type: topic
    prefix: feature/
    parent: main
    upstream_strategy: merge
    downstream_strategy: merge
    delete_on_finish: true
  bugfix:
    type: topic
    prefix: bugfix/
    parent: main
    upstream_strategy: merge
    downstream_strategy: merge
    delete_on_finish: true
  hotfix:
    type: topic
    prefix: hotfix/
    parent: main
    merge_into: [main]
    upstream_strategy: merge
    downstream_strategy: merge
    tag: true
    delete_on_finish: true
  release:
    type: topic
    prefix: release/
    parent: main
    merge_into: [main]
    upstream_strategy: merge
    downstream_strategy: merge
    tag: true
    delete_on_finish: true
